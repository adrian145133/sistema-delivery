{
  "framework": null,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/pedidos.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/loja/:slug",
      "destination": "/index.html?loja=:slug"
    },
    {
      "source": "/loja/:slug/",
      "destination": "/index.html?loja=:slug"
    },
    {
      "source": "/pedidos/:slug",
      "destination": "/pedidos.html?loja=:slug"
    },
    {
      "source": "/painel/:slug",
      "destination": "/pedidos.html?loja=:slug"
    }
  ]
}
