{
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/login.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/loja/:slug",
      "destination": "/index.html?loja=:slug"
    },
    {
      "source": "/loja/:slug/",
      "destination": "/index.html?loja=:slug"
    },
    {
      "source": "/pedidos/:slug",
      "destination": "/pedidos.html?loja=:slug"
    },
    {
      "source": "/painel/:slug",
      "destination": "/pedidos.html?loja=:slug"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/login/",
      "destination": "/login.html"
    }
  ]
}
